# Shared defaults — ESP32-C3 SuperMini (often 2MB flash) is the primary target
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_LWIP_MAX_SOCKETS=8
CONFIG_FREERTOS_HZ=1000

# C3 max is 160 MHz
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y

# SuperMini uses native USB Serial/JTAG for flash + serial monitor
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=n

# WPA3 SAE needed for WPA2/WPA3 mixed APs like "Home"
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=y
CONFIG_ESP_WIFI_ENABLE_SAE_PK=y

# Many C3 SuperMini boards have 2MB flash (not 4MB)
CONFIG_ESPTOOLPY_FLASHSIZE_2MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="2MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_2mb.csv"

# Do NOT use -Os on ESP32-C3 (IDF 6 / DIG-694 breaks the RISC-V memcpy build)
CONFIG_COMPILER_OPTIMIZATION_PERF=y
